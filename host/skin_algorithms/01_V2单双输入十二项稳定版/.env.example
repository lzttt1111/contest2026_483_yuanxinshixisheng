# DermaVision 运行配置模板
# 复制为 .env 并填入真实值（.env 已 gitignore，不会提交）。
# Redis 与 ai-skin-backend 共用；OSS 访问收敛到 backend internal-api。

# Celery / Redis（broker db0 / backend db1，与 ai-skin-backend 共用）
# 若 Redis 有密码：redis://:your-password@127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# 开发环境单 worker 跑 5 个 queue 时需要 5 个执行槽；
# 生产用 systemd 起 5 个独立 worker（各 concurrency=1，--concurrency 在 unit 里硬编码，不读此值）。
CELERY_WORKER_CONCURRENCY=5

# GPU 数值热点。生产环境严格要求 CUDA，不允许静默回退 CPU。
DERMAVISION_DEVICE=cuda:0
DERMAVISION_GPU_REQUIRED=true
DERMAVISION_GPU_MEMORY_FRACTION=0.18
DERMAVISION_GPU_PROFILE=compat
DERMAVISION_WARMUP_ON_START=true
PYTORCH_NVML_BASED_CUDA_CHECK=1

# backend internal-api 地址（worker 经 internal-api 上传/下载图片；
# OSS 凭证仅保留于 backend，worker 不直连 OSS）
PICTURE_SERVICE_BASE_URL=http://127.0.0.1:8000

# 医学 V2 旁路返回；默认开启，不替换旧 metrics。
ENABLE_MEDICAL_METRICS_V2=true

# Profile由run.py参数或run_cloud_worker.py目标设置。正式环境只允许
# institution/consumer，禁止auto；直接启动Python进程时可显式覆盖。
DERMAVISION_CAPTURE_PROFILE=institution
