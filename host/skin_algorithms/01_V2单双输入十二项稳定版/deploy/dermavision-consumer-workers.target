[Unit]
Description=AISIA Consumer RGB Twelve Analysis - Acne V2 Profile
Conflicts=dermavision-workers.target
Conflicts=dermavision-workers-v1.target
Requires=dermavision@consumer_redness.service
Requires=dermavision@consumer_spots.service
Requires=dermavision@consumer_brown.service
Requires=dermavision@consumer_texture.service
Requires=dermavision@consumer_pores.service
Requires=dermavision@consumer_purple.service
Requires=dermavision@consumer_acne_v2.service
Requires=dermavision@consumer_wrinkle.service
Requires=dermavision@consumer_surface_gloss.service
Requires=dermavision@consumer_vascular.service
Requires=dermavision@consumer_contour_firmness.service
After=dermavision@consumer_redness.service
After=dermavision@consumer_spots.service
After=dermavision@consumer_brown.service
After=dermavision@consumer_texture.service
After=dermavision@consumer_pores.service
After=dermavision@consumer_purple.service
After=dermavision@consumer_acne_v2.service
After=dermavision@consumer_wrinkle.service
After=dermavision@consumer_surface_gloss.service
After=dermavision@consumer_vascular.service
After=dermavision@consumer_contour_firmness.service

[Install]
WantedBy=multi-user.target
