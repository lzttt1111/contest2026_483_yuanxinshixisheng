[Unit]
Description=AISIA Single RGB Twelve Analysis - Default Acne V2 Profile
Conflicts=dermavision-workers-v1.target
Conflicts=dermavision-consumer-workers.target
Requires=dermavision@redness.service
Requires=dermavision@spots.service
Requires=dermavision@brown.service
Requires=dermavision@texture.service
Requires=dermavision@pores.service
Requires=dermavision@purple.service
Requires=dermavision@acne_v2.service
Requires=dermavision@wrinkle.service
Requires=dermavision@surface_gloss.service
Requires=dermavision@vascular.service
Requires=dermavision@contour_firmness.service
Requires=dermavision@summary.service
After=dermavision@redness.service
After=dermavision@spots.service
After=dermavision@brown.service
After=dermavision@texture.service
After=dermavision@pores.service
After=dermavision@purple.service
After=dermavision@acne_v2.service
After=dermavision@wrinkle.service
After=dermavision@surface_gloss.service
After=dermavision@vascular.service
After=dermavision@contour_firmness.service
After=dermavision@summary.service

[Install]
WantedBy=multi-user.target
